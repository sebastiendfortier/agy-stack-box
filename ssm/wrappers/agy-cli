#!/usr/bin/env bash
# agy-cli — SSM launcher (delegates to the package copy of common.sh).
set -euo pipefail
_PKG_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export AGY_STACK_STATE="${AGY_STACK_STATE:-${HOME}/.agy-stack/state}"
export SIF_PATH="${SIF_PATH:-${_PKG_ROOT}/share/container/agy-stack-box.sif}"
# shellcheck source=../share/lib/common.sh
source "${_PKG_ROOT}/share/lib/common.sh"

load_secrets
ensure_services
RT="$(resolve_runtime)"

# Default to OpenRouter Auto unless the caller already chose a model.
has_model=0
for arg in "$@"; do
  case "$arg" in
    --model|--model=*) has_model=1 ;;
  esac
done
if [[ $has_model -eq 0 ]]; then
  set -- --model custom-openrouter-auto "$@"
fi

client_session_begin cli
trap 'client_session_end' EXIT

exec_in_instance "$RT" "$INSTANCE_NAME" agy "$@"
