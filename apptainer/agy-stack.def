Bootstrap: docker
From: rockylinux:9

%labels
    Author sebastiendfortier
    App agy-stack-box
    Description Slim runtime: OpenRouter BYOK proxy + Electron libs. IDE/Obsidian/agy in state/apps via fetch-apps.sh.

%help
    Slim image. Large apps are NOT baked in — run ./scripts/fetch-apps.sh after setup-config.
    Then: start-services / start-ide / start-cli

%files
    rootfs-scripts/openrouter-proxy.sh /opt/agy-stack/host-scripts/openrouter-proxy.sh
    rootfs-scripts/agy.sh /opt/agy-stack/host-scripts/agy.sh
    rootfs-scripts/antigravity-ide.sh /opt/agy-stack/host-scripts/antigravity-ide.sh
    rootfs-scripts/obsidian-stack.sh /opt/agy-stack/host-scripts/obsidian-stack.sh
    rootfs-scripts/resolve-app.sh /opt/agy-stack/host-scripts/resolve-app.sh

%post
    set -euo pipefail
    ADD_MODEL_GIT='https://github.com/vahapogut/antigravity-add-model.git'
    ADD_MODEL_REF='f793635'
    NODE_VER='v22.14.0'

    # Do NOT run `dnf update` under fakeroot (filesystem RPM /dev chown fails).
    # Keep git/ssh/diff in the *final* image — agents and IDE terminals need them.
    # (Earlier builds removed git-core after npm build to save space; that broke workflows.)
    dnf -y install --allowerasing --setopt=install_weak_deps=False \
      ca-certificates curl tar gzip which findutils git-core openssh-clients \
      diffutils patch less procps-ng iproute \
      libX11 libXcomposite libXdamage libXext libXfixes libXrandr libxkbcommon \
      libxshmfence libdrm mesa-libGL mesa-libgbm nss nspr atk at-spi2-atk \
      gtk3 pango cairo alsa-lib cups-libs libsecret

    # Official Node binary (smaller than Nodesource RPM + repo metadata)
    curl -fsSL "https://nodejs.org/dist/${NODE_VER}/node-${NODE_VER}-linux-x64.tar.gz" -o /tmp/node.tgz
    mkdir -p /usr/local
    tar -xzf /tmp/node.tgz -C /usr/local --strip-components=1
    rm -f /tmp/node.tgz
    rm -rf /usr/local/lib/node_modules/npm/docs \
           /usr/local/lib/node_modules/npm/man \
           /usr/local/lib/node_modules/npm/html \
           /usr/local/include \
           /usr/local/share || true
    export PATH=/usr/local/bin:$PATH
    node -v && npm -v

    echo "Building antigravity-add-model (production prune)..."
    git clone "$ADD_MODEL_GIT" /opt/antigravity-add-model
    cd /opt/antigravity-add-model
    git checkout "$ADD_MODEL_REF"
    npm ci
    npm run build
    npm prune --omit=dev
    rm -rf .git src docs assets .github \
           tsconfig.json .eslintrc* .prettierrc* .gitignore .gitattributes \
           README* CHANGELOG* LICENSE* package-lock.json 2>/dev/null || true
    # Drop test/docs noise from deps
    find node_modules -type d \( -iname test -o -iname tests -o -iname __tests__ -o -iname docs -o -iname example -o -iname examples -o -iname '.github' \) -print0 2>/dev/null \
      | xargs -0 -r rm -rf
    find node_modules -type f \( -name '*.md' -o -name '*.ts' -o -name '*.map' -o -name 'LICENSE*' -o -name 'CHANGELOG*' -o -name '*.markdown' \) -delete 2>/dev/null || true

    mkdir -p /usr/local/bin /opt/agy-stack/host-scripts
    install -m 0755 /opt/agy-stack/host-scripts/resolve-app.sh /usr/local/bin/agy-resolve-app
    install -m 0755 /opt/agy-stack/host-scripts/openrouter-proxy.sh /usr/local/bin/openrouter-proxy
    install -m 0755 /opt/agy-stack/host-scripts/agy.sh /usr/local/bin/agy
    install -m 0755 /opt/agy-stack/host-scripts/antigravity-ide.sh /usr/local/bin/antigravity-ide
    install -m 0755 /opt/agy-stack/host-scripts/obsidian-stack.sh /usr/local/bin/obsidian-stack

    # Keep git/ssh; only drop dnf caches and docs to stay slim.
    dnf clean all
    rm -rf /var/cache/dnf /var/cache/yum /usr/share/doc /usr/share/man /usr/share/info \
           /tmp/node.tgz
    # Drop unused locales (keep C/UTF-8)
    find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'en*' ! -name 'C*' -exec rm -rf {} + 2>/dev/null || true

%environment
    export LC_ALL=C.UTF-8
    export CLOUD_CODE_URL=http://127.0.0.1:50999
    export PATH=/usr/local/bin:$PATH

%runscript
    echo "agy-stack-box slim — ./scripts/fetch-apps.sh then start-*"
    exec /bin/bash "$@"
