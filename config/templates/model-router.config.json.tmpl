{
  "listen": "127.0.0.1:{{ROUTER_PORT}}",
  "authToken": "{{ROUTER_TOKEN}}",
  "policy": {
    "commitAfterChars": 240,
    "maxHoldMs": 1500,
    "escalationTtlMs": 300000,
    "largePromptTokens": 60000,
    "maxToolsForSmall": 12,
    "repetitionMinRepeats": 3,
    "refusalPatterns": [
      "\\bI can'(?:t| not)\\b",
      "\\bI cannot\\b",
      "\\bI am unable\\b",
      "\\bI'm unable\\b",
      "\\bI do(?:n't| not) have (?:access|the ability)\\b",
      "\\bas an AI\\b"
    ],
    "actionIntentPatterns": [
      "\\b(edit|write|create|delete|remove|rename|move|fix|patch|update|implement|add|refactor)\\b",
      "\\b(run|execute|install|build|compile|test|lint|deploy)\\b",
      "\\b(read|open|inspect|search|grep|find|list)\\b"
    ]
  },
  "judge": {
    "enabled": true,
    "tier": "sg-qwen",
    "threshold": 0.6,
    "maxTokens": 2048
  },
  "tiers": [
    {
      "name": "sg-qwen",
      "baseUrl": "{{IHUB_BASE_URL}}",
      "model": "sg/qwen3.8-27b",
      "apiKeyEnv": "IHUB_API_KEY",
      "contextWindow": 262144,
      "supportsTools": true,
      "timeoutMs": 300000
    },
    {
      "name": "openrouter-auto",
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "openrouter/auto",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "contextWindow": 200000,
      "supportsTools": true,
      "timeoutMs": 180000
    }
  ]
}

