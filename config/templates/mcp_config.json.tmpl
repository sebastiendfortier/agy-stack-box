{
  "mcpServers": {
    "obsidian": {
      "headers": {
        "Authorization": "Bearer {{OBSIDIAN_API_KEY}}"
      },
      "serverUrl": "http://127.0.0.1:{{OBSIDIAN_REST_PORT}}/mcp/",
      "disabled": false,
      "timeoutSeconds": 300
    },
    "cmds-agent": {
      "serverUrl": "{{CMDS_AGENT_MCP_URL}}",
      "disabled": false,
      "timeoutSeconds": 300
    },
    "wiki": {
      "serverUrl": "{{WIKI_MCP_URL}}",
      "disabled": false,
      "timeoutSeconds": 300
    },
    "gitlab": {
      "serverUrl": "{{GITLAB_MCP_URL}}",
      "disabled": false,
      "timeoutSeconds": 300
    }
  }
}
