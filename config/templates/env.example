# Copy to state/secrets.env via ./scripts/setup-config.sh (mode 600).
# Never commit secrets.env.

# Required: OpenRouter BYOK key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Required: Obsidian Local REST API bearer token (matches vault plugin settings)
OBSIDIAN_API_KEY=

# Required: host path to the Obsidian vault (bind-mounted into the instance)
VAULT_HOST_PATH=

# Optional overrides (defaults are per-uid to avoid collisions on shared hosts)
# INSTANCE_NAME=agy-stack-$USER
# PROXY_PORT=   # default: 30000 + (uid%15000)*2
# OBSIDIAN_REST_PORT=  # default: PROXY_PORT+1
# DISPLAY=:0
# Extra filesystem binds for IDE file pickers (scratch, projects). Comma or space separated.
# AGY_EXTRA_BINDS=/scratch/$USER,/project/mygroup/$USER
# Override login home if getent is wrong: AGY_HOST_HOME=/home/$USER
# Use host /usr /bin /lib* inside the instance so IDE/CLI see normal system tools (default 1).
# AGY_HOST_OS_TOOLS=1
# Bind dirs from your login PATH / MODULEPATH / LD_LIBRARY_PATH (HPC modules) — default 1.
# AGY_HOST_PATH_BINDS=1


